# Copy to .env on macOS or Linux, or to config.bat on Windows.
# Do not commit real credentials.

# ---- server ----
QUANTIFY_HOST=127.0.0.1
QUANTIFY_PORT=8787
# QUANTIFY_DB=/absolute/path/to/data/quantify.db
QUANTIFY_SECURITY_PEPPER=replace-with-a-long-random-secret
QUANTIFY_SECURE_COOKIES=0
QUANTIFY_TRUST_PROXY=0
QUANTIFY_DEBUG=0

# ---- writing ----
# Quantify computes every number itself. A model is used only to turn those
# numbers into sentences, and only if a key is set. Claude Opus 5 is the
# recommendation: it holds several competing drivers in mind at once and writes
# an honest short paragraph about them. The daily write-up is cached, so this
# costs a few cents per location per day.
#   pip install anthropic
ANTHROPIC_API_KEY=
QUANTIFY_AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max. medium is the right balance for this work.
QUANTIFY_AI_EFFORT=medium

# ---- payments ----
# Stripe handles cards, invoices, tax, and dunning. Quantify never stores a card.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_FOUNDING=
# Monthly USD prices: One location $39; Up to three locations $99.
# Create/configure these separately; legacy IDs above remain unchanged.
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_TEAM=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
QUANTIFY_SUPPORT_EMAIL=support@yourdomain.com

# ---- weather ----
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ---- what is on nearby ----
PREDICTHQ_ACCESS_TOKEN=
PREDICTHQ_EVENTS_URL=https://api.predicthq.com/v1/events/
TICKETMASTER_API_KEY=
QUANTIFY_EVENT_RADIUS_MILES=15

# ---- register ----
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_VERSION=2026-07-15
SQUARE_MAX_PAGES=250
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
QUANTIFY_SQUARE_INTERNAL_LOCATION=

# ---- morning email ----
QUANTIFY_FROM_EMAIL=briefs@yourdomain.com
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
